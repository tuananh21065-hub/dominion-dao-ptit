{
  "name": "dominion-dao-ptit",
  "version": "1.0.0",
  "private": true,
  "description": "DominionDAO Smart Contract and React Web3 application for the PTIT practical exercise",
  "scripts": {
    "compile": "hardhat compile",
    "sync:abi": "node scripts/sync-abi.js",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "preflight:sepolia": "node scripts/sepolia-preflight.js",
