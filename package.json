    "@types/node": "22.10.2",
    "chai": "4.3.10",
    "dotenv": "16.4.7",
    "ethereum-waffle": "4.0.10",
    "hardhat": "2.22.19",
    "hardhat-gas-reporter": "1.0.10",
    "solidity-coverage": "0.8.14"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6",
    "ethers": "5.7.2"
  }
}
